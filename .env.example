VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used only by docker-compose.yml. AUTH_MODE=basic (default) keeps nginx's
# login prompt in front of the app, using BASIC_AUTH_USER/PASS below — change
# these before deploying. Set AUTH_MODE=none to turn that off instead, once
# the app's own Supabase Auth sign-in (above) is configured — otherwise this
# deployment has no login gate at all.
AUTH_MODE=basic
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=admin
